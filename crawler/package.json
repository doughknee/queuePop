{
  "name": "queuepop-crawler",
  "version": "0.1.0",
  "private": true,
  "description": "Crawls ranked League and TFT matches with a Riot personal API key, aggregates per-patch stats, serves them as JSON.",
  "main": "src/main.js",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/main.js",
    "aggregate": "node src/main.js aggregate",
    "backfill-patch": "node src/main.js backfill-patch",
    "backup": "node src/main.js backup",
    "backfill-length": "node src/main.js backfill-length",
    "backfill-comps": "node src/main.js backfill-comps",
    "backfill-players": "node src/main.js backfill-players",
    "vacuum": "node src/main.js vacuum",
    "mock": "node src/mock.js",
    "test": "node --test"
  }
}
