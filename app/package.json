{
  "name": "queuepop",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-lcu.js && node test-notify.js",
    "dist": "electron-builder --win nsis zip"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "^26.0.12"
  },
  "version": "2.0.0-alpha.1",
  "description": "queuePop - League of Legends queue auto-accept",
  "author": "Brandon Harris",
  "build": {
    "appId": "com.doughknee.queuepop",
    "productName": "queuePop (Electron)",
    "executableName": "queuePop-electron",
    "files": [
      "*.js",
      "!test-*.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../src/webui",
        "to": "src/webui"
      },
      {
        "from": "../src/_version.py",
        "to": "src/_version.py"
      },
      {
        "from": "../assets/queuepop.ico",
        "to": "assets/queuepop.ico"
      }
    ],
    "win": {
      "icon": "../assets/queuepop.ico",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "queuePop-electron-v${version}-${os}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "queuePop-electron-v${version}-setup.${ext}"
    }
  }
}
